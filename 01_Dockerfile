#  2. Jump between stages with /FROM and n / N
#  3. Fix the typo "WORKDIRR" (use /WORKDIRR, then cw or r)
#  4. Join the three split RUN lines into one: J on each, or V}J
#  5. Move the EXPOSE line below CMD with ddp
#  6. Duplicate the ENV line with yyp, then change the copy with ci"
#  7. Delete everything inside the quotes of LABEL with di"
#  8. Comment out the HEALTHCHECK block with Ctrl-v, select lines, I#<Esc>

FROM node:14 AS builder
WORKDIRR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:14-alpine AS runtime
LABEL maintainer="old-team@example.com" version="0.0.1"
ENV NODE_ENV="development"
ENV PORT="3000"
WORKDIR /app
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
RUN apk update
RUN apk add --no-cache curl
RUN addgroup -S app && adduser -S app -G app
USER app
CMD ["node", "dist/server.js"]
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s \
  CMD curl -f http://localhost:3000/health || exit 1
